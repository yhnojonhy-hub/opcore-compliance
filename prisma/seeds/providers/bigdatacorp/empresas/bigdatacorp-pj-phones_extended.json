{
  "slug": "bigdatacorp-pj-phones_extended",
  "name": "BigDataCorp — Telefones",
  "baseUrl": "https://plataforma.bigdatacorp.com.br",
  "httpMethod": "POST",
  "requestTemplate": {
    "path": "/empresas",
    "_bdcMeta": {
      "category": "empresas",
      "activationTier": 2,
      "dataset": "phones_extended",
      "schemaBlocks": ["cadastral"]
    },
    "headers": {
      "Accept": "application/json",
      "AccessToken": "env:BIGDATACORP_ACCESS_TOKEN",
      "TokenId": "env:BIGDATACORP_TOKEN_ID"
    },
    "body": {
      "Datasets": "phones_extended",
      "q": "doc{{{document}}}",
      "Limit": 1
    }
  },
  "authType": "env_headers",
  "fieldMappings": [
    {
      "source": "$.Result[0].Phones",
      "target": "sections.cadastral.phones"
    }
  ],
  "supportedTypes": ["CNPJ"],
  "isActive": true,
  "priority": 50
}
