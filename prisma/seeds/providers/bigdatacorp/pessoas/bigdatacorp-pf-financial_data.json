{
  "slug": "bigdatacorp-pf-financial_data",
  "name": "BigDataCorp — Informações Financeiras",
  "baseUrl": "https://plataforma.bigdatacorp.com.br",
  "httpMethod": "POST",
  "requestTemplate": {
    "path": "/pessoas",
    "_bdcMeta": {
      "category": "pessoas",
      "activationTier": 2,
      "dataset": "financial_data",
      "schemaBlocks": ["financial", "credit"]
    },
    "headers": {
      "Accept": "application/json",
      "AccessToken": "env:BIGDATACORP_ACCESS_TOKEN",
      "TokenId": "env:BIGDATACORP_TOKEN_ID"
    },
    "body": {
      "Datasets": "financial_data",
      "q": "doc{{{document}}}",
      "Limit": 1
    }
  },
  "authType": "env_headers",
  "fieldMappings": [
    {
      "source": "$.Result[0].FinantialData.TotalAssets",
      "target": "sections.financial.totalAssets"
    },
    {
      "source": "$.Result[0].FinantialData.IncomeEstimates",
      "target": "sections.financial.incomeEstimates"
    },
    {
      "source": "$.Result[0].FinantialData.TaxReturns",
      "target": "sections.financial.taxReturns"
    },
    {
      "source": "$.Result[0].FinancialData.TotalAssets",
      "target": "sections.financial.totalAssets"
    },
    {
      "source": "$.Result[0].FinancialData.IncomeEstimates",
      "target": "sections.financial.incomeEstimates"
    },
    {
      "source": "$.Result[0].FinancialData.TaxReturns",
      "target": "sections.financial.taxReturns"
    }
  ],
  "supportedTypes": ["CPF"],
  "isActive": true,
  "priority": 50
}
