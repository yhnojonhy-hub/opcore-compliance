{
  "slug": "bigdatacorp-pf-financial_risk",
  "name": "BigDataCorp — Risco Financeiro",
  "baseUrl": "https://plataforma.bigdatacorp.com.br",
  "httpMethod": "POST",
  "requestTemplate": {
    "path": "/pessoas",
    "_bdcMeta": {
      "category": "pessoas",
      "activationTier": 2,
      "dataset": "financial_risk",
      "schemaBlocks": ["financial", "credit"]
    },
    "headers": {
      "Accept": "application/json",
      "AccessToken": "env:BIGDATACORP_ACCESS_TOKEN",
      "TokenId": "env:BIGDATACORP_TOKEN_ID"
    },
    "body": {
      "Datasets": "financial_risk",
      "q": "doc{{{document}}}",
      "Limit": 1
    }
  },
  "authType": "env_headers",
  "fieldMappings": [
    {
      "source": "$.Result[0].FinancialRisk.TotalAssets",
      "target": "sections.financial.totalAssets"
    },
    {
      "source": "$.Result[0].FinancialRisk.EstimatedIncomeRange",
      "target": "sections.financial.estimatedIncomeRange"
    },
    {
      "source": "$.Result[0].FinancialRisk.FinancialRiskScore",
      "target": "sections.financial.financialRiskScore"
    },
    {
      "source": "$.Result[0].FinancialRisk.FinancialRiskLevel",
      "target": "sections.financial.financialRiskLevel"
    },
    {
      "source": "$.Result[0].FinancialRisk.IsCurrentlyOnCollection",
      "target": "sections.financial.isCurrentlyOnCollection"
    },
    {
      "source": "$.Result[0].FinancialRisk.IsCurrentlyEmployed",
      "target": "sections.credit.isCurrentlyEmployed"
    },
    {
      "source": "$.Result[0].FinancialRisk.IsCurrentlyOwner",
      "target": "sections.credit.isCurrentlyOwner"
    }
  ],
  "supportedTypes": ["CPF"],
  "isActive": true,
  "priority": 50
}
