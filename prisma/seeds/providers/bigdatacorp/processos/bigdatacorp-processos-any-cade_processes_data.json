    "body": {
      "Datasets": "cade_processes_data",
      "q": "doc{{{document}}}",
      "Limit": 1
    }
  },
  "authType": "env_headers",
  "fieldMappings": [
    {
      "source": "$.Result[0].Processes",
      "target": "sections.litigationEsg.lawsuits"
