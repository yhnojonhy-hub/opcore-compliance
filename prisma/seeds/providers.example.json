[
  {
    "slug": "bigdatacorp",
    "name": "BigDataCorp",
    "baseUrl": "https://api.bigdatacorp.com.br",
    "httpMethod": "POST",
    "requestTemplate": {
      "path": "/pessoas",
      "body": { "Datasets": "basic_data", "q": "doc{{document}}" }
    },
    "authType": "bearer",
    "authConfigRef": "BIGDATACORP_API_TOKEN",
    "fieldMappings": [
      { "source": "$.Result[0].BasicData.Name", "target": "sections.cadastral.fullName" },
      { "source": "$.Result[0].BasicData.TaxIdStatus", "target": "sections.cadastral.cpfStatus" },
      { "source": "$.Result[0].KycData.IsCurrentlyPEP", "target": "sections.pldft.isPep" }
    ],
    "supportedTypes": ["CPF", "CNPJ"],
    "isActive": false,
    "priority": 10
  },
  {
    "slug": "lemit-cpf",
    "name": "Lemit — CPF",
    "baseUrl": "https://api.lemit.com.br",
    "httpMethod": "POST",
    "requestTemplate": {
      "path": "/api/v1/consulta/pessoa",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "OpCore-Compliance/1.0"
      },
      "body": { "documento": "{{document}}" }
    },
    "authType": "bearer",
    "authConfigRef": "LEMIT_API_TOKEN",
    "fieldMappings": [
      { "source": "$.pessoa.nome", "target": "sections.cadastral.fullName" },
      { "source": "$.pessoa.situacao_cpf", "target": "sections.cadastral.cpfStatus" }
    ],
    "supportedTypes": ["CPF"],
    "isActive": false,
    "priority": 20
  },
  {
    "slug": "lemit-cnpj",
    "name": "Lemit — CNPJ",
    "baseUrl": "https://api.lemit.com.br",
    "httpMethod": "POST",
    "requestTemplate": {
      "path": "/api/v1/consulta/empresa",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "OpCore-Compliance/1.0"
      },
      "body": { "documento": "{{document}}" }
    },
    "authType": "bearer",
    "authConfigRef": "LEMIT_API_TOKEN",
    "fieldMappings": [
      { "source": "$.empresa.razao_social", "target": "sections.cadastral.legalName" },
      { "source": "$.empresa.situacao", "target": "sections.cadastral.cnpjStatus" }
    ],
    "supportedTypes": ["CNPJ"],
    "isActive": false,
    "priority": 20
  },
  {
    "slug": "brasilapi-cnpj",
    "name": "Brasil API — CNPJ (Minha Receita)",
    "baseUrl": "https://brasilapi.com.br/api",
    "httpMethod": "GET",
    "requestTemplate": {
      "path": "/cnpj/v1/{{document}}",
      "headers": {
        "Accept": "application/json",
        "User-Agent": "OpCore-Compliance/1.0 (homolog)"
      }
    },
    "authType": "none",
    "fieldMappings": [
      { "source": "$.razao_social", "target": "sections.cadastral.legalName" },
      { "source": "$.nome_fantasia", "target": "sections.cadastral.tradeName" },
      { "source": "$.descricao_situacao_cadastral", "target": "sections.cadastral.cnpjStatus" },
      { "source": "$.data_inicio_atividade", "target": "sections.cadastral.openingDate" },
      { "source": "$.cnae_fiscal", "target": "sections.cadastral.cnae" },
      { "source": "$.qsa", "target": "sections.corporateStructure.qsa" }
    ],
    "supportedTypes": ["CNPJ"],
    "isActive": true,
    "priority": 30
  },
  {
    "slug": "apibrasil",
    "name": "ApiBrasil",
    "baseUrl": "https://gateway.apibrasil.io",
    "httpMethod": "POST",
    "requestTemplate": {
      "path": "/api/v2/consulta",
      "body": { "tipo": "{{documentType}}", "documento": "{{document}}" }
    },
    "authType": "bearer",
    "authConfigRef": "APIBRASIL_API_TOKEN",
    "fieldMappings": [
      { "source": "$.response.processos", "target": "sections.litigation.lawsuits" },
      { "source": "$.response.trabalho_escravo", "target": "sections.esg.slaveLabor" }
    ],
    "supportedTypes": ["CPF", "CNPJ"],
    "isActive": false,
    "priority": 40
  }
]
