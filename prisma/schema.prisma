generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  CPF
  CNPJ
}

enum RiskLevel {
  baixo
  medio
  alto
  muito_alto
}

enum ComplianceStatus {
  aprovado
  pendente
  rejeitado
  revisao_manual
}

enum TargetType {
  CPF
  CNPJ
  PHONE
  EMAIL
  NAME
  PASSAPORTE
}

enum FindingCategory {
  IDENTITY
  ADDRESS
  SANCTION
  LAWSUIT
  MANDADO
  INTIMACAO
  FINANCIAL
  SOCIAL_PRESENCE
  NEWS
  BREACH
  DOMAIN
  ELECTORAL
  REPUTATION
  TRAVEL_DOC
}

enum SourceReliability {
  OFFICIAL
  COMMUNITY
  THIRD_PARTY
  SCRAPING
  PAID
}

enum IntelDossierStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
}

enum DossierPurpose {
  KYC
  PRE_CONTRACT
  MA
  LITIGATION
  CREDIT
}

enum DossierLegalBasis {
  CONTRACT
  LEGAL_RIGHTS
  LEGITIMATE_INTEREST
  CREDIT_PROTECTION
}

model Provider {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  baseUrl         String
  httpMethod      String
  requestTemplate Json
  authType        String
  authConfigRef   String?
  fieldMappings   Json
  supportedTypes  String[]
  isActive        Boolean  @default(true)
  priority        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultations ComplianceConsultation[]
  auditLogs     AuditLog[]
}

model ComplianceConsultation {
  id           String       @id @default(cuid())
  document     String
  documentType DocumentType
  providerId   String
  provider     Provider     @relation(fields: [providerId], references: [id])
  payload      Json
  rawPayload   Json
  requestedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  expiresAt    DateTime?

  @@unique([document, documentType, providerId])
  @@index([document])
  @@index([createdAt])
}

model ComplianceDossier {
  id           String       @id @default(cuid())
  document     String
  documentType DocumentType
  version      Int          @default(1)
  payload      Json
  completeness Float
  hash         String
  requestedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  riskAssessment RiskAssessment?

  @@unique([document, documentType, version])
  @@index([document])
  @@index([createdAt])
}

model RiskAssessment {
  id                   String            @id @default(cuid())
  dossierId            String            @unique
  dossier              ComplianceDossier @relation(fields: [dossierId], references: [id])
  level                RiskLevel
  score                Int
  factors              Json
  complianceStatus     ComplianceStatus
  blocked              Boolean           @default(false)
  requiresManualReview Boolean           @default(false)
  recommendation       String?
  createdAt            DateTime          @default(now())
}

model RiskRule {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  documentTypes String[]
  condition     Json
  weight        Int
  severity      String
  hardStop      Boolean    @default(false)
  minRiskLevel  RiskLevel?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AuditLog {
  id         String    @id @default(cuid())
  action     String
  document   String
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([document])
  @@index([createdAt])
}

model IntelDossier {
  id           String             @id @default(cuid())
  target       String
  targetType   TargetType
  status       IntelDossierStatus @default(PENDING)
  overallScore Int?
  purpose      DossierPurpose     @default(KYC)
  legalBasis   DossierLegalBasis  @default(LEGITIMATE_INTEREST)
  deepSearch   Boolean            @default(false)
  partyName    String?
  tenantId     String?
  error        String?
  requestedBy  String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sources  IntelDossierSource[]
  findings IntelDossierFinding[]
  auditLogs IntelDossierAuditLog[]

  @@index([target])
  @@index([targetType])
  @@index([status])
  @@index([createdAt])
}

model IntelDossierSource {
  id         String           @id @default(cuid())
  dossierId  String
  dossier    IntelDossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  name       String
  providerSlug String?
  category   FindingCategory
  reliability SourceReliability
  status     String
  httpStatus Int?
  durationMs Int?
  error      String?
  rawPayload Json?
  createdAt  DateTime         @default(now())

  @@index([dossierId])
}

model IntelDossierFinding {
  id          String            @id @default(cuid())
  dossierId   String
  dossier     IntelDossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  category    FindingCategory
  sourceName  String
  reliability SourceReliability
  confidence  Int
  title       String
  summary     String
  details     Json              @default("{}")
  url         String?
  occurredAt  DateTime?
  verified    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([dossierId])
  @@index([category])
}

model IntelDossierAuditLog {
  id        String       @id @default(cuid())
  dossierId String
  dossier   IntelDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  action    String
  actor     String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([dossierId])
  @@index([createdAt])
}
