PORT=3010
NODE_ENV=development

# Local: postgresql://compliance:compliance@127.0.0.1:5435/opcore_compliance
# Server (rede caddy): postgresql://opcore:CHANGE_ME@opcore-compliance-postgres:5432/opcore_compliance
DATABASE_URL=postgresql://compliance:compliance@127.0.0.1:5435/opcore_compliance

JWT_SECRET=change-me-min-32-chars-long
JWT_EXPIRES_IN=8h

# Local: http://localhost:5173,http://localhost:3000
# Produção: https://compliance.opcore.com.br (frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

CACHE_TTL_DAYS=30
API_SERVICE_KEY=change-me-api-service-key

LEMIT_API_TOKEN=

BIGDATACORP_ACCESS_TOKEN=
BIGDATACORP_TOKEN_ID=

DEFAULT_PROVIDER_SLUG=

BDC_MAX_TIER=3
BDC_CONSULT_CONCURRENCY=10
BDC_SANCTIONS_CONFIRMED_MATCH_RATE=85
INTEL_SYNC_TIMEOUT_MS=14000
INTEL_ASYNC_TIMEOUT_MS=40000

PORTAL_TRANSPARENCIA_TOKEN=
DATAJUD_API_KEY=
DATAJUD_TRIBUNAIS=tjsp,tjrj,tjmg,trt2,trf3
DATAJUD_TRIBUNAIS_DEEP=tjsp,tjrj,tjmg,tjrs,tjsc,tjpr,tjba,tjce,tjpe,tjdft,trf1,trf2,trf3,trf4,trf5,trf6,trt1,trt2,trt3,trt15,tst,stj
DATAJUD_REQUEST_TIMEOUT_MS=90000
HUNTER_API_KEY=
VERIPHONE_API_KEY=
OPENSANCTIONS_API_KEY=
APIFY_API_TOKEN=
INTERPOL_API_BASE=https://ws-public.interpol.int/notices/v1
PAID_PROVIDERS_ENABLED=

# Docker only (primeira subida): RUN_DB_SEED=true
